\@writefile{toc}{\contentsline {section}{\numberline {4}Contribution 2: Human Pose Estimation System}{13}{section.0.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces  (a) Inside the drone room. Similarly in red is the drone system and in grey the human system with the human localization kernel. In red above there is the drone localization and control system. In grey above is the human localization system. Here we focus on the human localization kernel or system. (b) Outside the room, a user is controlling and or monitoring the drones. He is able to see the drones and humans in the \gls {3D} space using the web interface. }}{13}{figure.caption.24}\protected@file@percent }
\newlabel{figsetting2}{{12}{13}{(a) Inside the drone room. Similarly in red is the drone system and in grey the human system with the human localization kernel. In red above there is the drone localization and control system. In grey above is the human localization system. Here we focus on the human localization kernel or system. (b) Outside the room, a user is controlling and or monitoring the drones. He is able to see the drones and humans in the \gls {3D} space using the web interface}{figure.caption.24}{}}
\newlabel{figsetting2@cref}{{[figure][12][0]12}{[1][13][]13}}
\gdef\@@FBset@vi{\global\c@FBcnt13}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Introduction}{13}{subsection.0.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces From Figure~\ref {figdepth} in~\blx@tocontentsinit {0}\cite {noauthor_projection_nodate} Showing the camera in the \gls {3D} space. Note the red segment, it shows the infrared ray going to the object from the camera and estimating the distance.}}{13}{figure.caption.25}\protected@file@percent }
\newlabel{figdepth2}{{13}{13}{From Figure~\ref {figdepth} in~\cite {noauthor_projection_nodate} Showing the camera in the \gls {3D} space. Note the red segment, it shows the infrared ray going to the object from the camera and estimating the distance}{figure.caption.25}{}}
\newlabel{figdepth2@cref}{{[figure][13][0]13}{[1][13][]13}}
\gdef\@@FBset@vii{\global\c@FBcnt13}
