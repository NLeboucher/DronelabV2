\newlabel{figkernel}{{14}{14}{\gls {HLK}, showing the main components of the system}{figure.caption.26}{}}
\newlabel{figkernel@cref}{{[figure][14][0]14}{[1][13][]14}}
\gdef\@@FBset@viii{\global\c@FBcnt14}
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Camera and Mediapipe Logic}{14}{subsubsection*.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Chessboard with the center of the \gls {3D} space. It shows the success calibration process of the camera.}}{14}{figure.caption.29}\protected@file@percent }
\newlabel{figchess}{{15}{14}{Chessboard with the center of the \gls {3D} space. It shows the success calibration process of the camera}{figure.caption.29}{}}
\newlabel{figchess@cref}{{[figure][15][0]15}{[1][14][]14}}
\gdef\@@FBset@ix{\global\c@FBcnt14}
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Architecture of the System}{14}{subsubsection*.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Intel Realsense D435, showing the workings of the depth camera and calibration capabilities, each pixel has been projected in the \gls {3D} space. The camera is able to capture the image and depth data, which is then processed. The depth data is used to estimate the distance from the pixels to humans then we are able to perform a change base to real world position from the camera RGB-D system. Which is enough data to be projected in \gls {3D} space.}}{15}{figure.caption.30}\protected@file@percent }
\newlabel{figrgbd}{{16}{15}{Intel Realsense D435, showing the workings of the depth camera and calibration capabilities, each pixel has been projected in the \gls {3D} space. The camera is able to capture the image and depth data, which is then processed. The depth data is used to estimate the distance from the pixels to humans then we are able to perform a change base to real world position from the camera RGB-D system. Which is enough data to be projected in \gls {3D} space}{figure.caption.30}{}}
\newlabel{figrgbd@cref}{{[figure][16][0]16}{[1][14][]15}}
\gdef\@@FBset@x{\global\c@FBcnt15}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Object Control Kernel, inside logics. We have three seperate threads/processes running. The first one sends the data to the client, the second one is the calibration process and the third one is the pose estimation process. Mediapipe runs in the pose estimation process. The calibration process is run once at the beginning at the load of the system, it can also be rerun later on when the camera moves.}}{15}{figure.caption.33}\protected@file@percent }
\newlabel{figOLK}{{17}{15}{Object Control Kernel, inside logics. We have three seperate threads/processes running. The first one sends the data to the client, the second one is the calibration process and the third one is the pose estimation process. Mediapipe runs in the pose estimation process. The calibration process is run once at the beginning at the load of the system, it can also be rerun later on when the camera moves}{figure.caption.33}{}}
\newlabel{figOLK@cref}{{[figure][17][0]17}{[1][15][]15}}
\gdef\@@FBset@xi{\global\c@FBcnt15}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces The web interface shows the positions of a human of the platform through its web interface run for a few seconds. It allows for the visualization of the humans in \gls {3D} space.}}{16}{figure.caption.34}\protected@file@percent }
\newlabel{figfastapi}{{18}{16}{The web interface shows the positions of a human of the platform through its web interface run for a few seconds. It allows for the visualization of the humans in \gls {3D} space}{figure.caption.34}{}}
\newlabel{figfastapi@cref}{{[figure][18][0]18}{[1][15][]16}}
\gdef\@@FBset@xii{\global\c@FBcnt16}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Evaluation and Results}{16}{subsection.0.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \gls {HLK} Issue, further the object is from the camera and the center of the image, the smaller it will be estimated. The distance to the camera does not change only the size of the object in the image does. For simplicity we have used the center of the image as the center of the camera and kept the operator parallel to the camera. Distances are expected to be less accurate with an operator not parallel to the camera.}}{16}{figure.caption.35}\protected@file@percent }
\newlabel{fig}{{19}{16}{\gls {HLK} Issue, further the object is from the camera and the center of the image, the smaller it will be estimated. The distance to the camera does not change only the size of the object in the image does. For simplicity we have used the center of the image as the center of the camera and kept the operator parallel to the camera. Distances are expected to be less accurate with an operator not parallel to the camera}{figure.caption.35}{}}
\newlabel{fig@cref}{{[figure][19][0]19}{[1][16][]16}}
\gdef\@@FBset@xiii{\global\c@FBcnt16}
